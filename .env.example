# Opción 1: Proxy local de Hermes (Nous Portal o proveedor configurado en Hermes)
HERMES_PROXY_URL=http://127.0.0.1:8645/v1
HERMES_MODEL=nous/welcome
HERMES_TIMEOUT_SECONDS=60

